{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nnennandukwe/signalpay-contracts/main/schemas/payment-event.schema.json",
  "title": "SignalPayPaymentEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "paymentId",
    "customerId",
    "amount",
    "currency",
    "status",
    "occurredAt"
  ],
  "$defs": {
    "paymentReviewReason": {
      "type": "string",
      "enum": ["velocity_check", "manual_kyc", "duplicate_capture", "sanctions_review"]
    },
    "paymentReviewHold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewId", "reason", "requestedAt"],
      "properties": {
        "reviewId": {
          "type": "string",
          "pattern": "^rev_"
        },
        "reason": {
          "$ref": "#/$defs/paymentReviewReason"
        },
        "requestedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "note": {
          "type": "string",
          "maxLength": 240
        }
      }
    }
  },
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "payment.pending",
        "payment.authorized",
        "payment.under_review",
        "payment.captured",
        "payment.failed"
      ]
    },
    "paymentId": {
      "type": "string",
      "pattern": "^pay_"
    },
    "customerId": {
      "type": "string",
      "pattern": "^cus_"
    },
    "amount": {
      "type": "integer",
      "minimum": 1
    },
    "currency": {
      "type": "string",
      "enum": ["USD"]
    },
    "status": {
      "type": "string",
      "enum": ["pending", "authorized", "under_review", "captured", "failed"]
    },
    "review": {
      "$ref": "#/$defs/paymentReviewHold"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
